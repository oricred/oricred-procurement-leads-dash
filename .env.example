# Copy to .env and fill in. Every ORICRED_* variable below without a default is
# required in production — the app refuses to start without them.
#
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Required ──────────────────────────────────────────────────────────────────

# Signing keys. Minimum 32 characters. Never reuse the values from any example.
ORICRED_JWT_SECRET=
ORICRED_SESSION_SECRET=

# Oricred's own database. All reads and writes go here.
ORICRED_DATABASE_URL=postgresql+asyncpg://oricred:oricred@localhost:5432/oricred

# The Tenders-SA database. STRICTLY READ-ONLY — see AGENTS.md "Database Rules".
# Credentials come from Tenders-SA; do not commit them.
ORICRED_TSA_DATABASE_URL=

# ── Optional ──────────────────────────────────────────────────────────────────

ORICRED_TSA_API_KEY=
ORICRED_REDIS_URL=redis://localhost:6379/0

ORICRED_SMTP_HOST=
ORICRED_SMTP_PORT=587
ORICRED_SMTP_USER=
ORICRED_SMTP_PASSWORD=

ORICRED_MONDAY_API_KEY=

# Browser origins allowed to call the API, comma-separated. Leave empty for the
# standard deployment, where FastAPI serves the built SPA from the same origin.
ORICRED_CORS_ORIGINS=

# Unattended first-boot administrator. Both must be set, and they only take
# effect when the database has no users. For interactive setup prefer:
#   python -m app.cli create-admin --email you@example.com --name "Your Name"
ORICRED_BOOTSTRAP_ADMIN_EMAIL=
ORICRED_BOOTSTRAP_ADMIN_PASSWORD=

# Logging. INFO is the default; DEBUG includes a line per rejected tender, which
# is tens of thousands per discovery pass.
# ORICRED_LOG_LEVEL=INFO
# One JSON object per line instead of console formatting, for log shipping.
# ORICRED_LOG_JSON=false

# Echo every SQL statement. LEAVE THIS OFF. Discovery issues four to six
# statements per tender across up to 20,000 tenders every fifteen minutes; the
# echo filled the production disk and was billed for by the log pipeline. Turn
# it on only for a short, deliberate investigation, and turn it off after.
# ORICRED_SQL_ECHO=false

# Connection pool for the Oricred database (PostgreSQL only; ignored on SQLite).
# SQLAlchemy's own defaults are 5 + 10, which the scheduled jobs exhausted.
# ORICRED_DB_POOL_SIZE=10
# ORICRED_DB_MAX_OVERFLOW=20
# ORICRED_DB_POOL_TIMEOUT=30
# ORICRED_DB_POOL_RECYCLE=1800

# ── Local development only ────────────────────────────────────────────────────

# Relaxes the production configuration guard and allows CORS from the Vite dev
# server. Never set this on a deployed instance.
# ORICRED_DEBUG=true
